# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ex_pass-*.tar

# Temporary files, for example, from tests.
/tmp/

# Ignore compiled Erlang modules
*.beam

# Ignore secret configuration files
/config/*.secret.exs

# Ignore Elixir Language Server files
.elixir_ls/
.qodo

# graph-fleet's own artifacts: the repo contract, the code graph and ontology,
# and each run's evidence and narration. All derived from this repository and
# rebuilt by `graph-bootstrap` / `index_repo.py` / `ontology project`, so they
# are machine-local rather than part of the library.
/.graph/
/.graph-fleet/
/.graph-runs/

# Agent tooling that is per-checkout, not per-project.
/.claude/
